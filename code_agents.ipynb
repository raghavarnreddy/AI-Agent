      "cell_type": "code",
      "source": [
        "!ollama pull qwen2.5-coder:7b\n",
        "from smolagents import LiteLLMModel, CodeAgent, DuckDuckGoSearchTool\n",
        "model = LiteLLMModel(model_id=\"ollama_chat/qwen2.5-coder:7b\",\n",
        "                     api_base=\"http://localhost:11434\", num_ctx=8192)"
      ],
      "metadata": {
