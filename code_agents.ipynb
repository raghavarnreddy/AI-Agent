    {
      "cell_type": "markdown",
      "metadata": {
        "id": "B0oLBr_qXSjA"
      },
      "source": [
        "Alfred is now connected 🔌! The runs from `smolagents` are being logged in Langfuse, giving him full visibility into the agent's behavior. With this setup, he's ready to revisit previous runs and refine his Party Preparator Agent even further.  "
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import warnings, logging, datetime\n",
        "\n",
        "# 1. Hide all Python warnings (DeprecationWarning, UserWarning, RuntimeWarning, FutureWarning)\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# 2. Stop the Colab/Jupyter \"utcnow() is deprecated\" spam at its source\n",
        "import jupyter_client.session as _s\n",
        "_s.utcnow = lambda: datetime.datetime.now(datetime.timezone.utc)\n",
        "\n",
        "# 3. (Optional) quiet noisy library logs\n",
        "logging.getLogger(\"opentelemetry\").setLevel(logging.CRITICAL)     # hides Langfuse 401 lines\n",
        "logging.getLogger(\"huggingface_hub\").setLevel(logging.ERROR)      # hides HF_TOKEN warnings\n",
        "logging.getLogger(\"LiteLLM\").setLevel(logging.ERROR)"
      ],
      "metadata": {
        "id": "aiUim-Y62m3u"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "from smolagents import CodeAgent\n",
        "\n",
        "alfred_agent = CodeAgent.from_hub('sergiopaniego/AlfredAgent', trust_remote_code=True)\n",
        "alfred_agent.model = model\n",
        "alfred_agent.max_steps = 4\n",
        "\n",
        "print(\"Using:\", type(alfred_agent.model).__name__, alfred_agent.model.model_id)\n",
        "\n",
        "alfred_agent.run(\"Give me best playlist for a party at the Wayne's mansion. The party idea is a 'villain masquerade' theme\")"
      ],
      "metadata": {
        "id": "O1ZKNM5T0zGY"
      },
      "execution_count": null,
      "outputs": []
    },
